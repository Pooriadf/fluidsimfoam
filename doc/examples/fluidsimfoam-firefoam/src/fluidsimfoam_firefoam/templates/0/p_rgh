    {
        type            fixedFluxPressure;
        gradient        uniform 0;
        value           uniform 101325;
    }

    door_right
    {
        type            totalPressure;
        p0              uniform 101325;
    }
    door_left
    {
        type            totalPressure;
        p0              uniform 101325;
    }


    main_outlet
    {
        type            totalPressure;
        p0              uniform 101325;
    }


    Door_wood_LEFT_left
    {
        type            fixedFluxPressure;
        gradient        uniform 0;
        value           uniform 101325;
    }

    Door_wood_LEFT_right
    {
        type            fixedFluxPressure;
        gradient        uniform 0;
        value           uniform 101325;
    }


    Door_wood_MAIN_right
    {
        type            fixedFluxPressure;
        gradient        uniform 0;
        value           uniform 101325;
    }

    Door_wood_MAIN_left
    {
        type            fixedFluxPressure;
        gradient        uniform 0;
        value           uniform 101325;
    }


    Door_wood_RIGHT_left
    {
        type            fixedFluxPressure;
        gradient        uniform 0;
        value           uniform 101325;
    }


    Door_wood_RIGHT_right
    {
        type            fixedFluxPressure;
        gradient        uniform 0;
        value           uniform 101325;
    }


    Hearth
    {
        type            fixedFluxPressure;
        gradient        uniform 0;
        value           uniform 101325;
    }

    walls
    {
        type            fixedFluxPressure;
        gradient        uniform 0;
        value           uniform 101325;
    }

}


